# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# --- API authentication ----------------------------------------------------
# Required. Callers must send this value in the X-API-Key header.
COLMILLO_API_KEY=change-me

# Comma-separated list of origins allowed by CORS (e.g. the UI host).
# Leave unset to disable cross-origin access (same-origin only).
COLMILLO_UI_ORIGIN=http://localhost:8501

# --- Persistence -----------------------------------------------------------
# SQLite file path. Inside the container this points at the mounted volume.
COLMILLO_DB_PATH=/var/data/colmillo.db

# --- Fixture / odds providers ---------------------------------------------
# API-Football credentials (legacy fixture + odds provider).
API_FOOTBALL_API_KEY=

# Default fixture provider: api-football | llm | auto
SOCCER_FIXTURE_PROVIDER=auto

# --- LLM enrichment / fixture LLM provider --------------------------------
OPENAI_API_KEY=
XAI_API_KEY=

# Optional: explicit fixture LLM provider config (otherwise inferred from
# OPENAI_API_KEY / XAI_API_KEY at runtime).
SOCCER_FIXTURE_LLM_PROVIDER=
SOCCER_FIXTURE_LLM_MODEL=
SOCCER_FIXTURE_LLM_BASE_URL=
SOCCER_FIXTURE_LLM_API_KEY=

# --- UI client config ------------------------------------------------------
# Where the Streamlit UI sends API calls. In docker-compose this resolves to
# the `api` service via the internal network.
COLMILLO_API_URL=http://api:8000

# httpx timeout in seconds.
COLMILLO_API_TIMEOUT=120
