# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
# Both the API and UI auto-load `.env` from the project root via python-dotenv.

# --- Required -----------------------------------------------------------------
# Gemini API key — the only credential needed for the pick pipeline.
GEMINI_API_KEY=

# --- API authentication (for HTTP service) ------------------------------------
# Required when running the FastAPI service. Callers send this as X-API-Key.
COLMILLO_API_KEY=change-me

# --- Optional LLM providers --------------------------------------------------
# Set these to use a different LLM provider instead of / alongside Gemini.
# OPENAI_API_KEY=
# XAI_API_KEY=
# COLMILLO_LLM_PROVIDER=gemini

# --- Fixture lookup (optional overrides) --------------------------------------
# SOCCER_FIXTURE_PROVIDER=auto
# SOCCER_FIXTURE_LLM_PROVIDER=gemini
# SOCCER_FIXTURE_LLM_MODEL=gemini-2.5-flash

# --- Persistence --------------------------------------------------------------
# For local dev use a relative path. Docker overrides to /var/data/colmillo.db.
COLMILLO_DB_PATH=./colmillo.db

# --- UI client config ---------------------------------------------------------
# For local dev both services run on localhost. Docker overrides to http://api:8000.
COLMILLO_API_URL=http://localhost:8000
COLMILLO_API_TIMEOUT=120
COLMILLO_UI_ORIGIN=http://localhost:8501

# --- Operational hardening ----------------------------------------------------
COLMILLO_RATE_LIMIT_PER_HOUR=30
# COLMILLO_ADMIN_API_KEY=

# --- Optional error reporting -------------------------------------------------
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
