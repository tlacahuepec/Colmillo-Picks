# Streamlit UI for the Colmillo-Picks API.

FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY services ./services

# Streamlit caches a metrics dir; point it at a writable temp location so the
# default user inside the slim image can write to it.
ENV STREAMLIT_HOME=/tmp/streamlit \
    PORT=8501
RUN mkdir -p /tmp/streamlit

EXPOSE 8501
CMD ["sh", "-c", "streamlit run services/ui/app.py --server.port ${PORT:-8501} --server.address 0.0.0.0 --server.headless true"]
