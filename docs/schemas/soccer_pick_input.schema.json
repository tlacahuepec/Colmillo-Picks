{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colmillo-picks/schemas/soccer_pick_input.schema.json",
  "title": "Soccer Pick Input Schema",
  "description": "Canonical input contract consumed by score_player_props.py and render_pick_report.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "match", "teams", "players", "market", "validation"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    },
    "match_id": { "type": "string" },
    "competition": { "type": "string" },
    "match": { "$ref": "#/$defs/match" },
    "teams": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/team" }
    },
    "players": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/player" }
    },
    "market": { "$ref": "#/$defs/market" },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["competition_type", "is_elimination", "overtime_possible", "kickoff_utc", "venue", "weather"],
      "properties": {
        "match_id": { "type": "string" },
        "competition_type": { "type": "string" },
        "is_elimination": { "type": "boolean" },
        "overtime_possible": { "type": "boolean" },
        "kickoff_utc": { "type": "string", "format": "date-time" },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "long": { "type": "string" },
            "short": { "type": "string" },
            "elapsed": { "type": "integer" }
          }
        },
        "venue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "city", "country"],
          "properties": {
            "name": { "type": "string" },
            "city": { "type": "string" },
            "country": { "type": "string" },
            "altitude_m": { "type": "number" },
            "surface": { "type": "string" }
          }
        },
        "weather": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "temperature_c", "wind_kph", "precipitation_probability", "source_timestamp_utc"],
          "properties": {
            "summary": { "type": "string" },
            "temperature_c": { "type": "number" },
            "wind_kph": { "type": "number", "minimum": 0 },
            "precipitation_probability": { "type": "number", "minimum": 0, "maximum": 1 },
            "source_timestamp_utc": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team_id",
        "team_name",
        "home_away",
        "projected_lineup",
        "injuries",
        "suspensions",
        "team_win_probability",
        "last_5_results",
        "possession_profile",
        "standings_context"
      ],
      "properties": {
        "team_id": { "type": "string" },
        "team_name": { "type": "string" },
        "home_away": { "type": "string", "enum": ["home", "away"] },
        "projected_lineup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "formation", "starters", "source_timestamp_utc"],
          "properties": {
            "status": { "type": "string", "enum": ["confirmed", "projected", "unknown"] },
            "formation": { "type": "string" },
            "starters": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 0,
              "maxItems": 11
            },
            "source_timestamp_utc": { "type": "string", "format": "date-time" }
          }
        },
        "injuries": {
          "type": "array",
          "items": { "$ref": "#/$defs/squadAvailabilityItem" }
        },
        "suspensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/squadAvailabilityItem" }
        },
        "team_win_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "last_5_results": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "string", "enum": ["W", "D", "L"] }
        },
        "possession_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["avg_possession_pct", "style_tag"],
          "properties": {
            "avg_possession_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "style_tag": {
              "type": "string",
              "enum": ["high_possession", "balanced", "direct_transition", "low_block_counter"]
            }
          }
        },
        "standings_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["table_position", "points", "games_played", "motivation_tag"],
          "properties": {
            "table_position": { "type": "integer", "minimum": 1 },
            "points": { "type": "integer", "minimum": 0 },
            "games_played": { "type": "integer", "minimum": 0 },
            "motivation_tag": {
              "type": "string",
              "enum": ["must_win", "title_race", "promotion_race", "europe_race", "relegation_battle", "midtable"]
            }
          }
        }
      }
    },
    "squadAvailabilityItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player_name", "status"],
      "properties": {
        "player_name": { "type": "string" },
        "reason": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["out", "doubtful", "questionable", "probable", "suspended"]
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player_id",
        "player_name",
        "team_id",
        "position_group",
        "expected_minutes",
        "substitution_risk",
        "expected_passes_baseline",
        "expected_shots_baseline",
        "market_lines"
      ],
      "properties": {
        "player_id": { "type": "string" },
        "player_name": { "type": "string" },
        "team_id": { "type": "string" },
        "position_group": { "type": "string", "enum": ["GK", "DEF", "MID", "FWD"] },
        "specific_role": { "type": "string" },
        "role_tag": { "type": "string" },
        "expected_minutes": { "type": "integer", "minimum": 0, "maximum": 130 },
        "substitution_risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "is_captain": { "type": "boolean" },
        "captain": { "type": "boolean" },
        "is_lone_striker": { "type": "boolean" },
        "set_piece_role": {
          "type": "string",
          "enum": ["none", "corners", "direct_free_kicks", "penalties", "multiple"]
        },
        "expected_passes_baseline": { "type": "number", "minimum": 0 },
        "expected_shots_baseline": { "type": "number", "minimum": 0 },
        "market_lines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passes", "shots"],
          "properties": {
            "passes": { "type": "number", "minimum": 0 },
            "shots": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_timestamp_utc", "sportsbook_snapshots"],
      "properties": {
        "source_timestamp_utc": { "type": "string", "format": "date-time" },
        "sportsbook_snapshots": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "odds_decimal"],
            "properties": {
              "source": { "type": "string" },
              "odds_decimal": { "type": "number", "exclusiveMinimum": 1 },
              "captured_at_utc": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical_missing_fields", "should_reject_prediction"],
      "properties": {
        "critical_missing_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "should_reject_prediction": { "type": "boolean" },
        "notes": { "type": "string" },
        "provider_status": { "$ref": "#/$defs/providerStatus" }
      }
    },
    "providerStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "lineup", "odds", "weather"],
      "properties": {
        "fixture": { "$ref": "#/$defs/providerStatusItem" },
        "lineup": { "$ref": "#/$defs/providerStatusItem" },
        "odds": { "$ref": "#/$defs/providerStatusItem" },
        "weather": { "$ref": "#/$defs/providerStatusItem" }
      }
    },
    "providerStatusItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "success", "fallback_used", "error_summary"],
      "properties": {
        "attempted": { "type": "boolean" },
        "success": { "type": "boolean" },
        "fallback_used": { "type": "boolean" },
        "error_summary": { "type": "string" }
      }
    }
  }
}
